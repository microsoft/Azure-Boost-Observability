NVME_GET_LOG_PAGE = 0x02
NVME_COMMAND_IDENTIFY = 0x06

NVME_IOCTL_ADMIN_CMD = 0xC0484E41
NVME_PERF_STATS_LOGPAGE_ID = 0xD1
NVME_NAMESPACE_ALL = 0xFFFFFFFF
VERSION = "1.0.0"

class nvme_admin_command(Structure):
    _fields_ = [("opcode", c_uint8),
                ("flags", c_uint8),
                ("cid", c_uint16),
                ("nsid", c_uint32),
                ("_reserved0", c_uint64),
                ("mptr", c_uint64),
                ("addr", c_uint64),
                ("mlen", c_uint32),
                ("alen", c_uint32),
                ("cdw10", c_uint32),
                ("cdw11", c_uint32),
                ("cdw12", c_uint32),
                ("cdw13", c_uint32),
                ("cdw14", c_uint32),
                ("cdw15", c_uint32),
                ("_reserved1", c_uint64)]

class nvme_get_stats_logpage(Structure):
    _fields_ = [("version", c_uint64),              # version of the log page format
                ("feature_available", c_uint64),    # indicates whether the performance statistics feature is available
                ("is_degraded", c_uint64),          # indicates whether the volume is in degraded performance state
                ("metadata_reserved", c_uint8 * (0x100 - 3 * sizeof(c_uint64))),  # reserved for future metadata
                ("total_read_ops", c_uint64),       # total number of read operations
                ("total_write_ops", c_uint64),      # total number of write operations
                ("total_read_bytes", c_uint64),     # total bytes read
                ("total_write_bytes", c_uint64),    # total bytes written
                ("outstanding_io", c_uint64),       # current volume queue length
                ("read_latency_max", c_uint64),     #  maximum observed latency for disk read I/O operations
                ("read_latency_avg", c_uint64),     #  average latency for disk read I/O operations
                ("write_latency_max", c_uint64),    #  maximum observed latency for disk write I/O operations
                ("write_latency_avg", c_uint64),    #  average latency for disk write I/O operations
                ("read_dispatch_latency_max", c_uint64),  #  maximum observed dispatch latency for disk read I/O operations
                ("read_dispatch_latency_avg", c_uint64),  #  average dispatch latency for disk read I/O operations
                ("write_dispatch_latency_max", c_uint64), #  maximum observed dispatch latency for disk write I/O operations
                ("write_dispatch_latency_avg", c_uint64), #  average dispatch latency for disk write I/O operations
                ("_reserved", c_uint8 * (0x1000 - 15 * sizeof(c_uint64))),  # reserved for future counters
                ]

    def __str__(self):
        out = ""
        out += f"  Degraded performance: {'Yes' if self.is_degraded else 'No'}\n"
        out += f"  Total Ops\n"
        out += f"    Read Ops: {self.total_read_ops}\n"
        out += f"    Write Ops: {self.total_write_ops}\n"
        out += f"  Total Bytes\n"
        out += f"    Read Bytes: {self.total_read_bytes}\n"
        out += f"    Write Bytes: {self.total_write_bytes}\n"
        out += f"  Outstanding I/Os: {self.outstanding_io}\n"
        out += f"  Ops Latency Max/Avg (us)\n"
        out += f"    Read Latency Max: {self.read_latency_max}\n"
        out += f"    Read Latency Avg: {self.read_latency_avg}\n"
        out += f"    Write Latency Max: {self.write_latency_max}\n"
        out += f"    Write Latency Avg: {self.write_latency_avg}\n"
        out += f"  Dispatch Latency Max/Avg (us)\n"
        out += f"    Read Dispatch Latency Max: {self.read_dispatch_latency_max}\n"
        out += f"    Read Dispatch Latency Avg: {self.read_dispatch_latency_avg}\n"
        out += f"    Write Dispatch Latency Max: {self.write_dispatch_latency_max}\n"
        out += f"    Write Dispatch Latency Avg: {self.write_dispatch_latency_avg}\n"
        out += f"\n";

        return out

    def to_dict(self):
        return {
            "is_degraded": self.is_degraded,
            "reads": self.total_read_ops,
            "writes": self.total_write_ops,
            "read_bytes": self.total_read_bytes,
            "write_bytes": self.total_write_bytes,
            "outstanding_io": self.outstanding_io,
            "read_latency_max": self.read_latency_max,
            "read_latency_avg": self.read_latency_avg,
            "write_latency_max": self.write_latency_max,
            "write_latency_avg": self.write_latency_avg,
            "read_dispatch_latency_max": self.read_dispatch_latency_max,
            "read_dispatch_latency_avg": self.read_dispatch_latency_avg,
            "write_dispatch_latency_max": self.write_dispatch_latency_max,
            "write_dispatch_latency_avg": self.write_dispatch_latency_avg
        }

class nvme_get_identify_namespace_data(Structure):
    #NVME_IDENTIFY_NAMESPACE_DATA
    _fields_ = [("NSZE", c_uint8 * (8 * sizeof(c_uint8))),               # byte 0:7 NSZE
                ("_skip_fields0", c_uint8 * (18 * sizeof(c_uint8))),     # byte 8:25 skipped fields
                ("FLBAS", c_uint8 * (1 * sizeof(c_uint8))),              # byte 26 FLBAS field
                ("_skip_fields1", c_uint8 * (77 * sizeof(c_uint8))),     # byte 27:103 skipped fields
                ("NGUID", c_uint8 * (16 * sizeof(c_uint8))),             # byte 104:119 NGUID field
                ("_skip_fields2", c_uint8 * (8 * sizeof(c_uint8))),      # byte 120:127 skipped fields
                ("LBAF", c_uint8 * (256 * sizeof(c_uint8))),             # byte 128:383 LBAF
                ("VS", c_uint8 * (3712 * sizeof(c_uint8)))               # byte 384:4095Vendor Specific area
                ]

    def process_fields(self):
        # decode size, for this we need to find the index in the LBAF array to find the sector size
        nsze = int.from_bytes(bytes(self.NSZE), byteorder='little')
        fblas = int.from_bytes(bytes(self.FLBAS), byteorder='little')
        lba_index = fblas & 0x0F # only the first 4 bits represent the index
        lba_data_size = self.LBAF[lba_index * 4 + 2] # index is lba_index * 4 (ULONG), + 2 because we need the 3rd byte of the LBAF structure

        # default to 512
        sector_size = 512
        if lba_data_size > 0:
            sector_size = 1 << lba_data_size
        # calculate disk size in GiB based on the number of sectors and sector size
        self.disk_size_gib = nsze * sector_size / (1024 ** 3)

        # process NGUID field
        nguid_bytes = bytes(self.NGUID)

        has_nguid = any(byte != 0 for byte in nguid_bytes)
        if(has_nguid):
            self.nguid = "%02X%02X%02X%02X-%02X%02X-%02X%02X-%02X%02X-%02X%02X%02X%02X%02X%02X" % tuple(nguid_bytes)
        else:
            self.nguid = "undefined"

        # Decode VS, strip trailing nulls and any leading nulls
        self.name_str = bytes(self.VS).decode(errors='ignore').rstrip('\0')

    def __str__(self):
        self.process_fields()
        out = ""
        out += f"  NGUID: {self.nguid}"
        out += f"\n"
        out += f"  Disk Size (GiB): {self.disk_size_gib:.2f}"
        out += f"\n"
        out += f"  Identify data: {self.name_str}"
        out += f"\n"
        return out
    
    def to_dict(self):
        self.process_fields()
        dict_obj = {
            "NGUID": self.nguid,
            "DiskSizeGiB": self.disk_size_gib,
            "VS": self.name_str,
            }

        return dict_obj

class nvme_device:
    def __init__(self, device):
        self.device = device

    def _nvme_ioctl(self, admin_cmd):
        with open(self.device, "r") as dev:
            try:
                ioctl(dev, NVME_IOCTL_ADMIN_CMD, admin_cmd)
            except (OSError) as err:
                print("Failed to issue nvme cmd, err: ", err)
                sys.exit(1)

class nvme_performance_stats(nvme_device):
    def _query_stats_from_device(self, _nsid):
        stats = nvme_get_stats_logpage()
        admin_cmd = nvme_admin_command(
            opcode=NVME_GET_LOG_PAGE,
            addr=addressof(stats),
            alen=sizeof(stats),
            nsid=_nsid,
            cdw10=(NVME_PERF_STATS_LOGPAGE_ID | (1023 << 16))
        )
        self._nvme_ioctl(admin_cmd)
        return stats

class nvme_identify_namespace_data(nvme_device):
    def _query_identify_namespace_data(self, _nsid):
        namespaceData = nvme_get_identify_namespace_data()
        admin_cmd = nvme_admin_command(
            opcode=NVME_COMMAND_IDENTIFY,
            addr=addressof(namespaceData),
            alen=sizeof(namespaceData),
            nsid=_nsid,
            cdw10=0
        )
        self._nvme_ioctl(admin_cmd)
        return namespaceData

def display_usage():
    print(f"Sample Utility tool for NVMe drive (version {VERSION})")
    print()
    print("Usage:")
    print(f"  > {sys.argv[0]} <device-name> [-j|--json]")
    print()
    print("Argument:")
    print("  <device-name>: device name of drive to be accessed")
    print("  -j, --json: output format json")

def get_disk_names():
    try:
        # Run lsblk with JSON output
        result = subprocess.run(['lsblk', '-J', '-o', 'NAME,TYPE'], capture_output=True, text=True, check=True)
        lsblk_output = json.loads(result.stdout)

        # Extract disk names
        disk_names = ["/dev/" + device['name'] for device in lsblk_output['blockdevices'] if device['type'] == 'disk']
        return disk_names

    except subprocess.CalledProcessError as e:
        print("Error running lsblk:", e)
        return []
    except json.JSONDecodeError as e:
        print("Error parsing JSON output:", e)
        return []

def get_nsid_for_device(nvme_device):
    result = subprocess.run(['nvme', 'list', '-o', 'json'], capture_output=True, text=True, check=True)
    nvme_list_output = json.loads(result.stdout)
    for device in nvme_list_output['Devices']:
        if device['DevicePath'] == nvme_device:
            return int(device['NameSpace'])
    return NVME_NAMESPACE_ALL

def print_stats_for_disk(disk_name, output_json):
    deviceNsid = get_nsid_for_device(disk_name)
    stats = nvme_performance_stats(disk_name)._query_stats_from_device(deviceNsid)

    if output_json:
        print(json.dumps({disk_name: stats.to_dict()}, indent=4))
    else:
        print(f"Perf stats for disk {disk_name}: {stats}")

def print_all_stats(output_json):
    all_stats = {}
    for disk_name in get_disk_names():
        stats = nvme_performance_stats(disk_name)._query_stats_from_device(get_nsid_for_device(disk_name))
        all_stats[disk_name] = stats.to_dict() if output_json else str(stats)

    if output_json:
        print(json.dumps(all_stats, indent=4))
    else:
        for disk_name, stats in all_stats.items():
            print(f"Disk: {disk_name}\n{stats}")

def print_stats_for_disk(disk_name, output_json):
    stats = nvme_performance_stats(disk_name)._query_stats_from_device(get_nsid_for_device(disk_name))
    if output_json:
        print(json.dumps({disk_name: stats.to_dict()}, indent=4))
    else:
        print(f"Disk: {disk_name}\n{stats}")

def identify_namespace_for_disk(disk_name, output_json):
    deviceNsid = get_nsid_for_device(disk_name)
    ns_data = nvme_identify_namespace_data(disk_name)._query_identify_namespace_data(deviceNsid)

    if output_json:
        print(json.dumps({disk_name: ns_data.to_dict()}, indent=4, ensure_ascii=True))
    else:
        print(f"Disk: {disk_name}\n{ns_data}")

def identify_all_namespaces(output_json):
    all_data = {}
    for disk_name in get_disk_names():
        data = nvme_identify_namespace_data(disk_name)._query_identify_namespace_data(get_nsid_for_device(disk_name))
        all_data[disk_name] = data.to_dict() if output_json else str(data)

    if output_json:
        print(json.dumps(all_data, indent=4))
    else:
        for disk_name, stats in all_data.items():
            print(f"Disk: {disk_name}\n{stats}")

def get_nvme_devadm_metadata(dev_path):
    model = None
    wwn = None

    try:
        output = subprocess.check_output(
            ["udevadm", "info", "--query=property", "--name", dev_path],
            text=True
        )
        props = dict(line.split("=", 1) for line in output.strip().split("\n") if "=" in line)
        model = props.get("ID_MODEL", "")
        wwn = props.get("ID_WWN", "")
    except subprocess.CalledProcessError:
        print(f"Failed to get metadata for device {dev_path}")
    
    return (model, wwn)

def create_udev_rules():

    sym_rule = {
        "os" : "disk/azure/os/",
        "data" : "disk/azure/data/",
        "local" : "disk/azure/local/"
    }

    rules = []
    for disk_name in get_disk_names():
        data = nvme_identify_namespace_data(disk_name)._query_identify_namespace_data(get_nsid_for_device(disk_name))
        
        VS_data = data.to_dict()
        if not VS_data:
            print(f"Detected NVMe device with no VS data: {disk_name}")
            continue

        VS_data["parsed_fields"] = {}

        if ',' in VS_data["VS"]:
            fields = VS_data["VS"].split(',')
            for field in fields:
                if '=' in field:
                    key, value = field.split('=', 1)
                    VS_data["parsed_fields"][key.strip()] = value.strip()

        type_str = VS_data["parsed_fields"].get("type", None)
        name_str = VS_data["parsed_fields"].get("name", None)

        if not type_str or not name_str:
            print(f"Detected NVMe device with unrecognized VS data: {VS_data}")
            continue

        if type_str not in sym_rule:
            print(f"Detected NVMe device with unsupported type '{type_str}': {VS_data}")
            continue

        model, wwn = get_nvme_devadm_metadata(disk_name)
        
        if "NVMe Direct Disk" in model or "MSFT NVMe Accelerator" in model:
            print(f"Detected NVMe device - Type: {type_str}, Name: {name_str}, Model: {model}, WWN: {wwn}") 
            symlink_name = f"{sym_rule[type_str]}/{name_str}"
            
            rule = f'ENV{{DEVTYPE}}=="disk", ENV{{ID_MODEL}}=="{model}", ENV{{ID_WWN}}=="{wwn}", SYMLINK+="{symlink_name}"'
            
            print(f"Generated udev rule: {rule}")
            rules.append(rule)
    
    udev_rule_file = "/etc/udev/rules.d/99-nvme-azure-remote.rules"

    try:
        with open(udev_rule_file, "w") as f:
            f.write("# Persistent symlinks for Azure remote NVMe data disks\n")
            f.write("\n".join(rules))
        print(f"Udev rule created at {udev_rule_file}. Please reload udev rules with 'sudo udevadm control --reload-rules' and 'sudo udevadm trigger` or replug your NVMe devices.")

        # run udevadm test /etc/udev/rules.d/99-nvme-azure-remote.rules
        subprocess.run(f"sudo udevadm control --reload-rules".split(" "), check=True)
        print("Reloaded udev rules successfully.")
    except PermissionError:
        print("Permission denied. Please run this script with sudo to create udev rules.")
    except Exception as e:
        print(f"An error occurred while creating udev rules: {e}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Display performance statistics for NVMe devices")
    parser.add_argument(
        "disk",
        nargs="?",
        help="Device to query"
    )
    parser.add_argument(
        "-j", "--json",
        action="store_true",
        help="Output in json format"
    )
    parser.add_argument(
        "--perf",
        action="store_true",
        help="Display performance statistics"
    )
    parser.add_argument(
        "--identify",
        action="store_true",
        help="Display identify namespace data"
    )
    parser.add_argument(
        "--create-udev-rules",
        action="store_true",
        help="Update udev rules for NVMe devices"
    )

    args = parser.parse_args()

    if args.perf:
        if args.disk:
            print_stats_for_disk(args.disk, args.json)
        else:
            print_all_stats(args.json)
    elif args.identify:
        if args.disk:
            identify_namespace_for_disk(args.disk, args.json)
        else:
            identify_all_namespaces(args.json)
    elif args.create_udev_rules:
        create_udev_rules()
    else:
        parser.print_usage()
